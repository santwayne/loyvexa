PRODUCT_NAME=Loyvexa
PORT=4000
NODE_ENV=development
DATABASE_URL=postgres://loyvexa:loyvexa@localhost:5432/loyvexa

# Long random string in production (openssl rand -hex 32)
JWT_SECRET=dev-only-change-me
ADMIN_TOKEN_TTL=12h
PARTICIPANT_TOKEN_TTL=60d

# Domain printed inside every QR code, e.g. https://wl.wayneesolutions.com
# Choose it carefully: once labels are printed it cannot change.
PUBLIC_BASE_URL=http://localhost:4000

# true = OTP returned in API response (dev only). Must be false in production.
OTP_DEV_MODE=true
OTP_RATE_LIMIT_PER_MINUTE=10
VERIFY_RATE_LIMIT_PER_MINUTE=30

# mock | razorpayx
PAYOUT_PROVIDER=mock
RAZORPAYX_KEY_ID=
RAZORPAYX_KEY_SECRET=
RAZORPAYX_ACCOUNT_NUMBER=
RAZORPAYX_WEBHOOK_SECRET=

CORS_ORIGINS=*

# Used by scripts/seed.js
SUPER_ADMIN_EMAIL=admin@wayneesolutions.com
SUPER_ADMIN_PASSWORD=ChangeMe@123

# Phase 2
# Encrypts WhatsApp tokens in the DB (openssl rand -hex 32). Never change after go-live.
ENCRYPTION_KEY=dev-only-encryption-key
# mock = replies saved in DB only; live = sent via Meta Cloud API
WHATSAPP_SEND_MODE=mock
WHATSAPP_VERIFY_TOKEN=dev-verify-token
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=v21.0
WORKER_INTERVAL_MS=15000

# Phase 3
# AI calls: mock | waynering
CALL_PROVIDER=mock
WAYNERING_BASE_URL=https://aicalling.wayneesolutions.com
WAYNERING_API_KEY=
CALL_WEBHOOK_SECRET=
# Korvo (formerly Royal) DMS — receives WhatsApp orders when a brand sets orderDms=korvo
KORVO_BASE_URL=
KORVO_API_KEY=
